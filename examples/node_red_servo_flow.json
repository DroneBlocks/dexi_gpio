[
    {
        "id": "dexi_servo_tab",
        "type": "tab",
        "label": "DEXI Servo",
        "disabled": false,
        "info": "Open/close control for the dexi_gpio servo_pwm_service via rosbridge_websocket.\n\nBefore use: edit the websocket client config and set the correct ws://<host>:9090 URL.\n\nRequires:\n- servo_pwm_service running on the companion computer\n- rosbridge_websocket running on port 9090"
    },
    {
        "id": "ws_client_cfg",
        "type": "websocket-client",
        "path": "ws://192.168.68.57:9090",
        "tls": "",
        "wholemsg": "false",
        "hb": "0",
        "subprotocol": ""
    },
    {
        "id": "inject_open",
        "type": "inject",
        "z": "dexi_servo_tab",
        "name": "Open",
        "props": [{"p": "payload"}],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
        "payloadType": "str",
        "x": 130,
        "y": 100,
        "wires": [["fn_open"]]
    },
    {
        "id": "fn_open",
        "type": "function",
        "z": "dexi_servo_tab",
        "name": "open (angle 150)",
        "func": "msg.payload = JSON.stringify({\n    op: \"call_service\",\n    service: \"/dexi/servo_control\",\n    type: \"dexi_interfaces/srv/ServoControl\",\n    args: { pin: 21, angle: 150, min_pw: 0, max_pw: 0 }\n});\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 100,
        "wires": [["ws_out"]]
    },
    {
        "id": "inject_close",
        "type": "inject",
        "z": "dexi_servo_tab",
        "name": "Close",
        "props": [{"p": "payload"}],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
        "payloadType": "str",
        "x": 130,
        "y": 180,
        "wires": [["fn_close"]]
    },
    {
        "id": "fn_close",
        "type": "function",
        "z": "dexi_servo_tab",
        "name": "close (angle 30)",
        "func": "msg.payload = JSON.stringify({\n    op: \"call_service\",\n    service: \"/dexi/servo_control\",\n    type: \"dexi_interfaces/srv/ServoControl\",\n    args: { pin: 21, angle: 30, min_pw: 0, max_pw: 0 }\n});\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 180,
        "wires": [["ws_out"]]
    },
    {
        "id": "ws_out",
        "type": "websocket out",
        "z": "dexi_servo_tab",
        "name": "rosbridge 9090",
        "server": "",
        "client": "ws_client_cfg",
        "x": 590,
        "y": 140,
        "wires": []
    },
    {
        "id": "ws_in",
        "type": "websocket in",
        "z": "dexi_servo_tab",
        "name": "rosbridge replies",
        "server": "",
        "client": "ws_client_cfg",
        "x": 170,
        "y": 280,
        "wires": [["dbg_reply"]]
    },
    {
        "id": "dbg_reply",
        "type": "debug",
        "z": "dexi_servo_tab",
        "name": "servo reply",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "x": 400,
        "y": 280,
        "wires": []
    }
]
